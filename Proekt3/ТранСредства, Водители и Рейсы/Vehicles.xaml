<Page x:Class="Proekt3.ТранСредства__Водители_и_Рейсы.Vehicles"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Proekt3.ТранСредства__Водители_и_Рейсы"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="900"
      Title="Vehicles">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Margin="0,0,20,0">
                <Label Content="Поиск по Гос.номеру"/>
                <TextBox Padding="5" Name="SearchBox" Width="200"/>
            </StackPanel>
            <StackPanel Margin="0,0,20,0">
                <Label Content="Фильтрация по модели" />
                <ComboBox Name="ModelBox" Width="180" />
            </StackPanel>

            <StackPanel Margin="0,0,15,0">
                <Label Content="Доступность" />
                <ComboBox Name="AvailabilityBox" Width="150">
                    <ComboBoxItem Content="Все" IsSelected="True"/>
                    <ComboBoxItem Content="Доступен" />
                    <ComboBoxItem Content="В ремонте" />
                    <ComboBoxItem Content="В рейсе" />
                </ComboBox>
            </StackPanel>

            <StackPanel Margin="10,0,10,0">
                <Label Content="Сортировка"/>
                <ComboBox Name="SortBox" SelectedIndex="0">
                    <ComboBoxItem Content="А -> Я"/>
                    <ComboBoxItem Content="Я -> А"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,5">
                <Button Content="Применить" Padding="5" Click="ApplyFilter" Margin="0,0,10,0"/>
                <Button Content="Сбросить" Padding="5" Click="ResetFilter" />
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="2" Name="VehiclesGrid" 
          AutoGenerateColumns="False" IsReadOnly="True" 
          SelectionMode="Single" SelectionUnit="FullRow"
          CanUserAddRows="False"
          CanUserSortColumns="True">
            <DataGrid.Columns >
                <DataGridTextColumn Header="Гос.номер" Binding="{Binding LicensePlate}" Width="*"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="*"/>
                <DataGridTextColumn Header="Год выпуска" Binding="{Binding YearOfManufacture}" Width="*"/>
                <DataGridTextColumn Header="Пробег" Binding="{Binding Mileage}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="" Binding="{Binding Badge}" Width="120" Foreground="Red" FontWeight="Bold"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="AddBtn" Content="Добавить" Margin="0,0,10,0" Click="AddBtn_Click" />
            <Button x:Name="EditBtn" Content="Редактировать" Margin="0,0,10,0" Click="EditBtn_Click"/>
            <Button x:Name="DeleteBtn" Content="Удалить" Margin="0,0,10,0" Click="DeleteBtn_Click"/>
            <Button x:Name="ReportBtn" Content="Отчет по пробегу" Click="ReportBtn_Click" Padding="10,5" Margin="0,0,10,0"/>
        </StackPanel>
    </Grid>
</Page>

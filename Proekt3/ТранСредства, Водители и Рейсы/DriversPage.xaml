<Page x:Class="Proekt3.ТранСредства__Водители_и_Рейсы.DriversPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Proekt3.ТранСредства__Водители_и_Рейсы"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DriversPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <StackPanel Margin="0,0,20,0">
                <Label Content="Поиск по ФИО"/>
                <TextBox Padding="5" Name="SearchBox" Width="200"/>
            </StackPanel>
            
            <StackPanel Margin="10,0,10,0">
                <Label Content="Сортировка"/>
                <ComboBox Name="SortBox" SelectedIndex="0">
                    <ComboBoxItem Content="А -> Я"/>
                    <ComboBoxItem Content="Я -> А"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="300,0,0,5">
                <Button Content="Применить" Padding="5" Click="ApplyFilter" Margin="0,0,10,0"/>
                <Button Content="Сбросить" Padding="5" Click="ResetFilter" />
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="2" Name="DriversGrid" 
       AutoGenerateColumns="False" IsReadOnly="True" 
       SelectionMode="Single" SelectionUnit="FullRow"
       CanUserAddRows="False"
       CanUserSortColumns="True">
            <DataGrid.Columns >
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Номер ВУ" Binding="{Binding LicenseNumber}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNumber}" Width="*"/>
                <DataGridTextColumn Header="Стаж" Binding="{Binding Experience}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="AddBtn" Content="Добавить" Margin="0,0,10,0" Click="AddBtn_Click" />
            <Button x:Name="EditBtn" Content="Редактировать" Margin="0,0,10,0" Click="EditBtn_Click"/>
            <Button x:Name="DeleteBtn" Content="Удалить" Margin="0,0,10,0" Click="DeleteBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>

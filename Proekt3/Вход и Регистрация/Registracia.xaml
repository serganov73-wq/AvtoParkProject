<Page x:Class="Proekt3.Вход_и_Регистрация.Registracia"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Proekt3.Вход_и_Регистрация"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="800"
      Title="Registracia">

    <StackPanel Margin="50" VerticalAlignment="Center">
        <TextBlock Text="Регистрация" 
               FontSize="30"
               FontWeight="Black"
               HorizontalAlignment="Center"/>

        <StackPanel Margin="0,20,0,0">
            <Label Content="ФИО" />
            <TextBox Name="FIOBox" Padding="20,8" />
            <TextBlock Name="FIOError" Foreground="#FFA50000" FontSize="12" Margin="0,2,0,10" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Margin="0,20,0,0">
            <Label Content="Логин" />
            <TextBox Name="LoginBox" Padding="20,8" />
            <TextBlock Name="LoginError" Foreground="#FFA50000" FontSize="12" Margin="0,2,0,10" TextWrapping="Wrap" />

        </StackPanel>

        <StackPanel Margin="0,20,0,0">
            <Label Content="Почта" />
            <TextBox Name="MailBox" Padding="20,8" />
            <TextBlock Name="MailError" Foreground="#FFA50000" FontSize="12" Margin="0,2,0,10" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Margin="0,20,0,0">
            <Label Content="Пароль" />
            <PasswordBox Name="PasswordInput" Padding="20,8" />
            <TextBlock Name="PasswordError" Foreground="#FFA50000" FontSize="12" Margin="0,2,0,10" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Margin="0,20,0,0">
            <Label Content="Повтор пароля" />
            <PasswordBox Name="PasswordRepeatInput" Padding="20,8" />
            <TextBlock Name="PasswordRepeatError" Foreground="#FFA50000" FontSize="12" Margin="0,2,0,10" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Margin="0,20,0,0">
            <Label Content="Выбор доступа:" />
            <ComboBox Name="RoleBox">
                <ComboBoxItem Content="Пользователь"/>
                <ComboBoxItem Content="Администратор"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Margin="30" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Регистрация" 
            Padding="40,5"
            HorizontalAlignment="Center"
                Margin="10"
                Click="RegisterClick"/>

            <Button Content="К авторизации" 
    Padding="40,5"
    HorizontalAlignment="Center"
                Margin="10"
                Click="CloseWindow_Click"/>
        </StackPanel>

    </StackPanel>
</Page>

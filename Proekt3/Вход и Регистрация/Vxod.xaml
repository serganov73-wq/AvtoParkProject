<Page x:Class="Proekt3.Вход_и_Регистрация.Vxod"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Proekt3.Вход_и_Регистрация"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Vxod">

    <StackPanel Margin="50" VerticalAlignment="Center">
        <TextBlock Text="Вход в систему" 
               FontSize="30"
               FontWeight="Black"
               HorizontalAlignment="Center"/>
        <StackPanel Margin="0,20,0,0">
            <Label Content="Логин или электронная почта" />
            <TextBox Name="LoginBox" Padding="20,8" />
        </StackPanel>

        <StackPanel Margin="0,20,0,0">
            <Label Content="Пароль" />
            <PasswordBox Name="PasswordInput" Padding="20,8" />
        </StackPanel>

        <StackPanel Margin="30" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Войти" 
            Padding="40,5"
            HorizontalAlignment="Center"
                Margin="10"
                Click="LoginClick"/>

            <Button Content="Регистрация" 
    Padding="40,5"
    HorizontalAlignment="Center"
                Margin="10"
                Click="OpenRegisterWindow_Click"/>
        </StackPanel>

    </StackPanel>
</Page>
